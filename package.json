{
  "name": "@florent-uzio/xrpl-mcp",
  "version": "1.0.0",
  "description": "MCP server exposing XRP Ledger tools and token issuance workflows",
  "license": "ISC",
  "author": "Florent Uzio",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/florent-uzio/xrpl-mastra-ai.git"
  },
  "type": "module",
  "bin": {
    "xrpl-mcp": "dist/mcp/xrpl-mcp.js"
  },
  "files": [
    "dist/mcp/xrpl-mcp.js",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "keywords": [
    "xrpl",
    "xrp-ledger",
    "mcp",
    "model-context-protocol"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "mastra dev",
    "build": "mastra build",
    "start": "mastra start",
    "eval": "tsx --env-file=.env evals/run.ts",
    "mcp": "tsx src/mcp/stdio.ts",
    "build:mcp": "esbuild src/mcp/stdio.ts --bundle --platform=node --format=esm --target=node22 --packages=external --banner:js=\"#!/usr/bin/env node\" --outfile=dist/mcp/xrpl-mcp.js",
    "prepack": "npm run build:mcp"
  },
  "dependencies": {
    "@mastra/core": "^1.78.0",
    "@mastra/libsql": "^1.26.2",
    "@mastra/loggers": "^1.3.8",
    "@mastra/mcp": "^2.5.0",
    "@mastra/memory": "^1.38.0",
    "xrpl": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "mastra": "^1.34.2",
    "prettier": "^3.9.10",
    "prettier-plugin-organize-imports": "^4.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
